<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for NotifyIcon: WPF has no tray icon of its own, and this ships with the desktop SDK
         so it beats taking a dependency. WinForms types stay fully qualified to avoid the
         Application/MessageBox name clashes. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FiveMManager</AssemblyName>
    <RootNamespace>FiveMManager</RootNamespace>
    <ApplicationIcon>logo.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <Version>1.0.6</Version>
    <!-- Velopack needs to run before any UI exists, so App owns an explicit Main instead of letting
         the WPF SDK generate one. That means App.xaml is a Page, not the ApplicationDefinition. -->
    <StartupObject>FiveMManager.App</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml"/>
    <Page Include="App.xaml"/>
  </ItemGroup>
  <ItemGroup>
    <!-- UseWindowsForms adds global usings for these two, which make Application, MessageBox and
         Brush ambiguous against their WPF namesakes in every file. We want exactly two types out of
         WinForms/GDI and both are fully qualified, so drop the global usings instead. -->
    <Using Remove="System.Windows.Forms"/>
    <Using Remove="System.Drawing"/>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>
</Project>
